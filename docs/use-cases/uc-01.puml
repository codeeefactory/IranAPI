@startuml
!include style.puml
actor Visitor
actor "Authenticated Developer" as Developer
rectangle IranAPI {
  usecase "UC-01\nDiscover APIs" as Main
  usecase "Search and filter" as Search
  usecase "Sort and paginate" as Sort
  usecase "Open API details" as Detail
}
Visitor --> Main
Developer --> Main
Search ..> Main : <<extend>>
Sort ..> Main : <<extend>>
Detail ..> Main : <<extend>>
@enduml
