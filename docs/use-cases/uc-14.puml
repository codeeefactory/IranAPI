@startuml
!include style.puml
actor "Authenticated Developer" as Developer
actor "Deployment Worker" as Worker
actor "Docker Engine" as Docker
rectangle IranAPI {
  usecase "UC-14\nDeploy project archive" as Main
  usecase "Re-analyze and store archive" as Analyze
  usecase "Queue deployment" as Queue
  usecase "Build image" as Build
  usecase "Run restricted container" as Run
  usecase "Check health and expose URL" as Health
}
Developer --> Main
Main ..> Analyze : <<include>>
Main ..> Queue : <<include>>
Worker --> Queue
Worker --> Build
Worker --> Run
Worker --> Health
Docker --> Build
Docker --> Run
Build ..> Queue : <<extend>>
Run ..> Build : <<include>>
Health ..> Run : <<include>>
@enduml
