DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
# Comma-separated hostnames. "*" accepts any deployment domain.
DJANGO_ALLOWED_HOSTS=*
IRANAPI_TRUST_PROXY_SSL_HEADER=true
MONGO_ROOT_USERNAME=iranapi
MONGO_ROOT_PASSWORD=replace-with-a-strong-database-password
IRANAPI_MONGODB_DATABASE=iranapi
IRANAPI_PROJECT_ARCHIVE_ROOT=/app/media/project-archives
IRANAPI_PROJECT_DEPLOYMENT_PUBLIC_HOST=http://localhost
IRANAPI_PROJECT_DEPLOYMENT_BUILD_TIMEOUT_SECONDS=900
IRANAPI_PROJECT_DEPLOYMENT_MEMORY=512m
IRANAPI_PROJECT_DEPLOYMENT_CPUS=1.0
IRANAPI_AUTO_SEED_SAMPLE_DATA=true

# Optional social-login authorization URLs. Leave blank to keep buttons disabled.
# Use the complete URL generated by your OAuth broker/provider configuration.
IRANAPI_GOOGLE_AUTH_URL=
IRANAPI_GITHUB_AUTH_URL=

# Optional real-provider credentials used only by the secure backend caller.
NESHAN_SERVICE_KEY=
KAVENEGAR_API_KEY=
ZARINPAL_MERCHANT_ID=
ARVANCLOUD_API_KEY=
